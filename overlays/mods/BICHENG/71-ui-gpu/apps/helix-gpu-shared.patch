+} // namespace
+
+int main(int argc, char** argv) {
+    const bool async = argc > 1 && std::strcmp(argv[1], "--async") == 0;
+    const int first_argument = async ? 2 : 1;
+    if (argc < first_argument + 1 || argc > first_argument + 2) {
+        std::fprintf(stderr, "Usage: helix-gpu-self-test [--async] OUTPUT_DIRECTORY [GCODE_FILE]\n");
+        return 2;
+    }
+    try {
+        const std::filesystem::path output = std::filesystem::absolute(argv[first_argument]);
+        std::filesystem::create_directories(output / "config");
+        setenv("HELIX_CONFIG_DIR", (output / "config").c_str(), 1);
+        helix::internal::set_main_thread_id();
+        spdlog::set_level(spdlog::level::debug);
+        auto file = parse(argc == first_argument + 2 ? argv[first_argument + 1] : nullptr);
+        lv_init();
+        lv_tick_set_cb([]() -> uint32_t {
+            return static_cast<uint32_t>(std::chrono::duration_cast<std::chrono::milliseconds>(
+                Clock::now().time_since_epoch()).count());
+        });
+        lv_xml_init();
+        lv_display_t* display = lv_display_create(480, 320);
+        require(display != nullptr, "memory display allocation failed");
+        std::vector<uint8_t> framebuffer(480 * 320 * 4);
+        lv_display_set_color_format(display, LV_COLOR_FORMAT_ARGB8888);
+        lv_display_set_buffers(display, framebuffer.data(), nullptr, framebuffer.size(),
+                               LV_DISPLAY_RENDER_MODE_FULL);
