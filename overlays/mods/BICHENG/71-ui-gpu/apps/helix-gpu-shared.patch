+#ifdef HELIX_PLATFORM_SNAPMAKER_U1
+    const char* gpu_enabled = std::getenv("UI_GPU_ENABLED");
+    const bool gpu_on = gpu_enabled && std::strcmp(gpu_enabled, "1") == 0;
+    const uint32_t period_ms = gpu_on ? 22 : 33;
+    lv_timer_t* display_timer = lv_display_get_refr_timer(m_display);
+    lv_timer_t* animation_timer = lv_anim_get_timer();
+    if (display_timer)
+        lv_timer_set_period(display_timer, period_ms);
+    if (animation_timer)
+        lv_timer_set_period(animation_timer, period_ms);
+    spdlog::info("[UI GPU] enabled={} display_period_ms={} animation_period_ms={}", gpu_on,
+                 display_timer ? period_ms : 0, animation_timer ? period_ms : 0);
+    m_render_report_start = lv_tick_get();
+    m_render_frames = 0;
+    lv_display_add_event_cb(m_display, [](lv_event_t* event) {
+        auto* self = static_cast<DisplayManager*>(lv_event_get_user_data(event));
+        ++self->m_render_frames;
+        const uint32_t elapsed = lv_tick_elaps(self->m_render_report_start);
+        if (elapsed >= 5000) {
+            spdlog::debug("[UI GPU] render_ready_frames={} elapsed_ms={} render_fps={:.2f}",
+                          self->m_render_frames, elapsed, 1000.0 * self->m_render_frames / elapsed);
+            self->m_render_frames = 0;
+            self->m_render_report_start = lv_tick_get();
+        }
+    }, LV_EVENT_RENDER_READY, this);
+#endif
+
     return true;
 }
 
