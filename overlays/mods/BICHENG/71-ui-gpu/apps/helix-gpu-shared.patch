+void gcode_viewer_set_watchdog_track(lv_obj_t* object, const GcodeViewerWatchdogTrack& track) {
+    if (auto* viewer = state(object))
+        viewer->watchdog = track;
+}
+bool gcode_viewer_watchdog_can_draw(lv_obj_t* object) {
+    auto* viewer = state(object);
+    return viewer && !viewer->paused && lv_obj_is_visible(object);
+}
+} // namespace helix::test_access
