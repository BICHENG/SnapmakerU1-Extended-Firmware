+    Scene(ParsedGCodeFile& source, bool disabled) : file(source), off(disabled) {
+        auto geometry = build_3d_geometry_in_budget(file, "GPU self-test");
+        if (off) {
+            require(!geometry, "GPU-disabled build allocated 3D geometry");
+        } else {
+            require(geometry && !geometry->vertices.empty(), "budgeted G-code geometry unavailable");
+            geometry_vertices = geometry->vertices.size();
+            geometry_triangles = geometry->extrusion_triangle_count + geometry->travel_triangle_count;
+            for (const auto& buffer : geometry->prepared_buffers)
+                gpu_upload_vertices += buffer.vertex_count;
+            gpu.set_prebuilt_geometry(std::move(geometry), "gpu-self-test");
+            gpu.set_filament_color("#FF6B35");
+            if (!file.object_name_table.empty())
+                gpu.set_highlighted_object(file.object_name_table.front());
+        }
+        cpu.set_gcode(&file);
+        cpu.set_current_layer(static_cast<int>(file.layers.size()) - 1);
+    }
+
+    static void draw(lv_event_t* event) {
+        auto& scene = *static_cast<Scene*>(lv_event_get_user_data(event));
+        lv_area_t area;
+        lv_obj_get_coords(static_cast<lv_obj_t*>(lv_event_get_target(event)), &area);
+        auto start = Clock::now();
+        scene.gpu.render(lv_event_get_layer(event), scene.file, scene.camera, &area);
+        if (scene.off && scene.gpu.render_failed())
+            scene.cpu.render(lv_event_get_layer(event), &area);
+        scene.render_ms = std::chrono::duration<double, std::milli>(Clock::now() - start).count();
+    }
+};
+
+void write_ppm(const std::filesystem::path& path, const lv_draw_buf_t& image) {
+    std::ofstream output(path, std::ios::binary);
+    output << "P6\n" << image.header.w << ' ' << image.header.h << "\n255\n";
+    bool varied = false;
+    for (uint32_t y = 0; y < image.header.h; ++y) {
+        const auto* row = image.data + static_cast<size_t>(y) * image.header.stride;
+        for (uint32_t x = 0; x < image.header.w; ++x) {
+            varied |= std::memcmp(row + x * 4, image.data, 3) != 0;
+            const char rgb[] = {static_cast<char>(row[x * 4 + 2]),
+                                static_cast<char>(row[x * 4 + 1]), static_cast<char>(row[x * 4])};
+            output.write(rgb, sizeof(rgb));
+        }
+    }
+    require(output.good(), "cannot write snapshot");
+    require(varied, "snapshot contains only one color");
+}
+
+void run_case(Scene& scene, lv_obj_t* object, int width, int height, float azimuth, float elevation,
+              const std::filesystem::path& prefix, std::ostream& report) {
+    scene.gpu.set_viewport_size(width, height);
+    scene.camera.set_viewport_size(width, height);
+    scene.camera.set_azimuth(azimuth);
+    scene.camera.set_elevation(elevation);
+    scene.camera.fit_to_bounds(scene.file.global_bounding_box);
+    scene.cpu.set_canvas_size(width, height);
+    scene.cpu.auto_fit();
+    lv_obj_set_size(object, width, height);
+    lv_obj_update_layout(object);
+    lv_draw_buf_t* snapshot = lv_snapshot_create_draw_buf(object, LV_COLOR_FORMAT_ARGB8888);
+    require(snapshot != nullptr, "snapshot allocation failed");
+    std::unique_ptr<lv_draw_buf_t, decltype(&lv_draw_buf_destroy)> image(snapshot, lv_draw_buf_destroy);
+    auto draw_frame = [&]() {
+        GCodeGLESSelfTestAccess::redraw(scene.gpu);
+        require(lv_snapshot_take_to_draw_buf(object, LV_COLOR_FORMAT_ARGB8888, snapshot) == LV_RESULT_OK,
+                "snapshot render failed");
+    };
+    for (int frame = 0; frame < 120; ++frame) {
+        draw_frame();
+        if (frame >= 3 && !scene.gpu.is_uploading() &&
+            (!scene.off || !scene.cpu.needs_more_frames()))
+            break;
+    }
+    require(!scene.gpu.is_uploading(), "geometry upload did not finish");
+    std::vector<double> render_times;
+    for (int frame = 0; frame < 20; ++frame) {
+        draw_frame();
+        render_times.push_back(scene.render_ms);
+    }
+    const bool initialized = GCodeGLESSelfTestAccess::initialized(scene.gpu);
+    const bool dma = GCodeGLESSelfTestAccess::dma(scene.gpu);
+    const int client_version = GCodeGLESSelfTestAccess::client_version(scene.gpu);
+    const auto& rgba = GCodeGLESSelfTestAccess::pixels(scene.gpu);
+    if (scene.off) {
+        require(!initialized && scene.gpu.render_failed() && rgba.empty(), "off mode initialized GLES");
+    } else {
+        require(initialized && !scene.gpu.render_failed() && client_version == 2, "GLES2 rendering failed");
+        require(rgba.size() == static_cast<size_t>(width) * height * 4, "wrong RGBA buffer size");
+        const char* mode = std::getenv("UI_GPU_OUTPUT");
+        if (mode && std::strcmp(mode, "readback") == 0)
+            require(!dma, "readback mode used DMA-BUF");
+        else
+            require(dma, "shared output unavailable; renderer fell back to readback");
+        std::ofstream raw(prefix.string() + ".rgba", std::ios::binary);
+        raw.write(reinterpret_cast<const char*>(rgba.data()), static_cast<std::streamsize>(rgba.size()));
+        require(raw.good(), "cannot write RGBA output");
+    }
+    size_t selected = 0;
+    for (size_t i = 3; i < rgba.size(); i += 4)
+        selected += rgba[i] == kSelectedAlpha;
+    if (!scene.off && !scene.file.object_name_table.empty())
+        require(selected > 0, "selected object has no alpha tags");
+    write_ppm(prefix.string() + ".ppm", *snapshot);
+    std::sort(render_times.begin(), render_times.end());
+    const size_t count = render_times.size();
+    const double median = (render_times[(count - 1) / 2] + render_times[count / 2]) * 0.5;
+    report << "{\"width\":" << width << ",\"height\":" << height
+           << ",\"gles_initialized\":" << (initialized ? "true" : "false")
+           << ",\"gles_client_version\":" << client_version
+           << ",\"output\":\"" << (scene.off ? "cpu2d" : dma ? "dmabuf" : "readback")
+           << "\",\"selected_alpha_pixels\":" << selected
+           << ",\"render_median_ms\":" << median
+           << ",\"render_p95_ms\":" << render_times[(count * 95 + 99) / 100 - 1]
+           << ",\"measured_frames\":" << render_times.size() << "}";
+}
+
+void check_progress_alpha(const std::filesystem::path& output) {
+    GCodeParser parser;
+    parser.parse_line("G90");
+    parser.parse_line("M83");
+    parser.parse_line("EXCLUDE_OBJECT_DEFINE NAME=selected CENTER=50,30");
+    parser.parse_line("EXCLUDE_OBJECT_DEFINE NAME=other CENTER=50,70");
+    for (int layer = 0; layer < 2; ++layer) {
+        parser.parse_line("G1 Z" + std::to_string(0.2 * (layer + 1)));
+        for (int object = 0; object < 2; ++object) {
+            const int x = 20 + layer * 40, y = 20 + object * 40;
+            parser.parse_line(std::string("EXCLUDE_OBJECT_START NAME=") + (object ? "other" : "selected"));
+            parser.parse_line("G1 X" + std::to_string(x) + " Y" + std::to_string(y) + " F1200");
+            parser.parse_line("G1 X" + std::to_string(x + 20) + " Y" + std::to_string(y) + " E1");
+            parser.parse_line("G1 X" + std::to_string(x + 20) + " Y" + std::to_string(y + 20) + " E1");
+            parser.parse_line("G1 X" + std::to_string(x) + " Y" + std::to_string(y + 20) + " E1");
+            parser.parse_line("G1 X" + std::to_string(x) + " Y" + std::to_string(y) + " E1");
+            parser.parse_line("EXCLUDE_OBJECT_END");
+        }
+    }
+    auto file = parser.finalize(true);
+    require(file.layers.size() == 2, "alpha fixture must have two layers");
+    Scene scene(file, false);
+    constexpr int width = 317, height = 193;
+    scene.gpu.set_viewport_size(width, height);
+    scene.camera.set_viewport_size(width, height);
+    scene.camera.set_azimuth(0);
+    scene.camera.set_elevation(85);
+    scene.camera.fit_to_bounds(file.global_bounding_box);
+    lv_obj_t* object = lv_obj_create(lv_screen_active());
+    lv_obj_remove_style_all(object);
+    lv_obj_remove_flag(object, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_set_size(object, width, height);
+    lv_obj_add_event_cb(object, Scene::draw, LV_EVENT_DRAW_MAIN, &scene);
+    lv_obj_update_layout(object);
+    std::unique_ptr<lv_draw_buf_t, decltype(&lv_draw_buf_destroy)> snapshot(
+        lv_snapshot_create_draw_buf(object, LV_COLOR_FORMAT_ARGB8888), lv_draw_buf_destroy);
+    require(snapshot != nullptr, "alpha snapshot allocation failed");
+    auto draw = [&] {
+        GCodeGLESSelfTestAccess::redraw(scene.gpu);
+        require(lv_snapshot_take_to_draw_buf(object, LV_COLOR_FORMAT_ARGB8888, snapshot.get()) == LV_RESULT_OK,
+                "alpha snapshot failed");
+        require(!scene.gpu.render_failed(), "alpha fixture GLES failed");
+    };
+    for (int frame = 0; frame < 8; ++frame) {
+        draw();
+        if (frame >= 3 && !scene.gpu.is_uploading())
+            break;
+    }
+    require(!scene.gpu.is_uploading(), "alpha fixture upload incomplete");
+    std::ofstream raw(output / "alpha-fixture.rgba", std::ios::binary);
+    std::ofstream report(output / "alpha-checks.json");
+    report << "{\"width\":" << width << ",\"height\":" << height << ",\"frames\":[";
+    bool first = true;
+    auto capture = [&](const char* name) {
+        draw();
+        auto rgba = GCodeGLESSelfTestAccess::pixels(scene.gpu);
+        require(rgba.size() == static_cast<size_t>(width) * height * 4, "alpha fixture RGBA size");
+        size_t selected = 0;
+        for (size_t i = 3; i < rgba.size(); i += 4) {
+            require(rgba[i] == 255 || rgba[i] == kSelectedAlpha, "ghost contaminated alpha tag channel");
+            selected += rgba[i] == kSelectedAlpha;
+        }
+        if (!first) report << ',';
+        first = false;
+        report << "{\"name\":\"" << name << "\",\"offset\":" << raw.tellp()
+               << ",\"bytes\":" << rgba.size() << ",\"selected_alpha_pixels\":" << selected << '}';
+        raw.write(reinterpret_cast<const char*>(rgba.data()), static_cast<std::streamsize>(rgba.size()));
+        return rgba;
+    };
+    auto alpha = [](const std::vector<uint8_t>& rgba) {
+        std::vector<uint8_t> result;
+        result.reserve(rgba.size() / 4);
+        for (size_t i = 3; i < rgba.size(); i += 4) result.push_back(rgba[i]);
+        return result;
+    };
+    scene.gpu.set_layer_range(0, 0);
+    scene.gpu.set_print_progress_layer(-1);
+    const auto lower = capture("solid_lower");
+    const auto lower_alpha = alpha(lower);
+    require(std::count(lower_alpha.begin(), lower_alpha.end(), kSelectedAlpha) > 0,
+            "solid lower layer must have selected pixels");
+    scene.gpu.set_layer_range(0, 1);
+    scene.gpu.set_print_progress_layer(0);
+    scene.gpu.set_ghost_opacity(64);
+    const auto ghost64 = capture("ghost_64");
+    require(alpha(ghost64) == lower_alpha && ghost64 != lower, "half-transparent ghost changed tags or was not drawn");
+    scene.gpu.set_ghost_opacity(255);
+    const auto ghost255 = capture("ghost_255");
+    require(alpha(ghost255) == lower_alpha && ghost255 != ghost64,
+            "opaque ghost changed tags or ignored opacity");
+    scene.gpu.set_print_progress_layer(-1);
+    const auto all_alpha = alpha(capture("solid_all"));
+    require(std::count(all_alpha.begin(), all_alpha.end(), kSelectedAlpha) >
+                std::count(lower_alpha.begin(), lower_alpha.end(), kSelectedAlpha),
+            "upper fixture layer must contain visible selected pixels");
+    scene.gpu.set_highlighted_objects({});
+    const auto none = alpha(capture("none_selected"));
+    require(std::all_of(none.begin(), none.end(), [](uint8_t value) { return value == 255; }),
+            "clearing selection left stale tags");
+    scene.gpu.set_highlighted_object("other");
+    const auto other = alpha(capture("other_selected"));
+    require(std::count(other.begin(), other.end(), kSelectedAlpha) > 0, "second object was not tagged");
+    for (size_t i = 0; i < other.size(); ++i)
+        require(other[i] != kSelectedAlpha || all_alpha[i] != kSelectedAlpha,
+                "disjoint objects share selection tags");
+    scene.gpu.set_highlighted_object("selected");
+    scene.gpu.set_layer_range(0, 0);
+    require(alpha(capture("solid_lower_again")) == lower_alpha, "state changes left stale alpha");
+    report << "],\"passed\":true}\n";
+    require(raw.good() && report.good(), "cannot write alpha evidence");
+    lv_obj_delete(object);
+}
+
+struct AsyncScene {
+    std::shared_ptr<const ParsedGCodeFile> file;
+    std::unique_ptr<GCodeGLESRenderer> gpu = std::make_unique<GCodeGLESRenderer>();
+    GCodeCamera camera;
+    std::vector<double> callback_times;
+
+    explicit AsyncScene(std::shared_ptr<const ParsedGCodeFile> source) : file(std::move(source)) {
+        gpu->enable_async();
+        require(!gpu->render_failed(), "cannot enable async GLES renderer");
+    }
+    void load(const char* name) {
+        auto geometry = build_3d_geometry_in_budget(*file, "Async GPU self-test");
+        require(geometry && !geometry->vertices.empty(), "async geometry unavailable");
+        gpu->set_prebuilt_geometry(std::move(geometry), name);
+        camera.set_viewport_size(317, 193);
+        camera.set_azimuth(45);
+        camera.set_elevation(35);
+        camera.fit_to_bounds(file->global_bounding_box);
+    }
+    static void draw(lv_event_t* event) {
+        auto& scene = *static_cast<AsyncScene*>(lv_event_get_user_data(event));
+        lv_area_t area;
+        lv_obj_get_coords(lv_event_get_target_obj(event), &area);
+        const auto start = Clock::now();
+        scene.gpu->render_async(lv_event_get_layer(event), scene.file, scene.camera, &area);
+        scene.callback_times.push_back(
+            std::chrono::duration<double, std::milli>(Clock::now() - start).count());
+    }
+};
+
+void check_async(std::shared_ptr<const ParsedGCodeFile> source,
+                 const std::filesystem::path& output, std::ostream& report) {
+    AsyncScene scene(std::move(source));
+    scene.load("async-initial");
+    scene.gpu->set_extrusion_color(lv_color_hex(0xFF6B35));
+    std::unique_ptr<lv_obj_t, decltype(&lv_obj_delete)> object(
+        lv_obj_create(lv_screen_active()), lv_obj_delete);
+    lv_obj_remove_style_all(object.get());
+    lv_obj_remove_flag(object.get(), LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_set_size(object.get(), 317, 193);
+    lv_obj_add_event_cb(object.get(), AsyncScene::draw, LV_EVENT_DRAW_MAIN, &scene);
+    lv_obj_update_layout(object.get());
+    std::unique_ptr<lv_draw_buf_t, decltype(&lv_draw_buf_destroy)> snapshot(
+        lv_snapshot_create_draw_buf(object.get(), LV_COLOR_FORMAT_ARGB8888), lv_draw_buf_destroy);
+    require(snapshot != nullptr, "async snapshot allocation failed");
+
+    bool reject_old_orange = false;
+    size_t checked_blue_frames = 0;
+    auto draw = [&] {
+        require(lv_snapshot_take_to_draw_buf(object.get(), LV_COLOR_FORMAT_ARGB8888,
+                                            snapshot.get()) == LV_RESULT_OK,
+                "async snapshot failed");
+        require(!scene.gpu->render_failed(), "async GLES failed");
+        const auto* image = GCodeGLESSelfTestAccess::completed_image(*scene.gpu);
+        if (reject_old_orange && image) {
+            size_t blue = 0;
+            for (uint32_t y = 0; y < image->header.h; ++y) {
+                const auto* row = image->data + static_cast<size_t>(y) * image->header.stride;
+                for (uint32_t x = 0; x < image->header.w; ++x) {
+                    require(row[x * 3 + 2] <= row[x * 3] + 2,
+                            "old orange model reappeared after reload");
+                    blue += row[x * 3] > row[x * 3 + 2] + 20;
+                }
+            }
+            require(blue > 0, "reloaded blue model has no visible geometry");
+            ++checked_blue_frames;
+        }
+    };
+    auto settle = [&] {
+        const auto start = Clock::now();
+        do {
+            draw();
+            if (!scene.gpu->is_uploading() &&
+                GCodeGLESSelfTestAccess::completed_image(*scene.gpu))
+                return std::chrono::duration<double, std::milli>(Clock::now() - start).count();
+            require(Clock::now() - start < std::chrono::seconds(90),
+                    "async renderer did not complete its latest request");
+            std::this_thread::sleep_for(std::chrono::milliseconds(2));
+        } while (true);
+    };
+
+    require(!GCodeGLESSelfTestAccess::completed_image(*scene.gpu),
+            "new async renderer already contains an image");
+    const double first_ms = settle();
+    write_ppm(output / "async-first.ppm", *snapshot);
+    for (int i = 0; i < 48; ++i) {
+        scene.camera.rotate(4.0f, 0.0f);
+        scene.camera.fit_to_bounds(scene.file->global_bounding_box);
+        draw();
+    }
+    const double latest_ms = settle();
+    write_ppm(output / "async-latest.ppm", *snapshot);
+
+    // Leave orange work pending, then exercise the viewer's exact clear order.
+    scene.camera.rotate(29.0f, 0.0f);
+    scene.camera.fit_to_bounds(scene.file->global_bounding_box);
+    draw();
+    const bool clear_while_pending = scene.gpu->is_uploading();
+    scene.gpu->release_geometry();
+    scene.gpu->clear_cached_frame();
+    require(!scene.gpu->has_geometry() &&
+                !GCodeGLESSelfTestAccess::completed_image(*scene.gpu),
+            "release/clear retained a model or image");
+    draw();
+    require(!GCodeGLESSelfTestAccess::completed_image(*scene.gpu),
+            "cleared model republished an image");
+
+    // A controlled two-object model makes stale-color and picking checks exact,
+    // even when the optional input has no EXCLUDE_OBJECT metadata.
+    scene.file = std::make_shared<const ParsedGCodeFile>(parse(nullptr));
+    std::weak_ptr<const ParsedGCodeFile> reloaded_lifetime = scene.file;
+    scene.load("async-reloaded");
+    scene.gpu->set_extrusion_color(lv_color_hex(0x2266FF));
+    scene.gpu->set_highlighted_objects({});
+    reject_old_orange = true;
+    const double reload_ms = settle();
+    write_ppm(output / "async-reloaded.ppm", *snapshot);
+
+    GCodeGLESRenderer picker; // CPU picking creates no EGL context.
+    picker.set_viewport_size(317, 193);
+    std::vector<glm::vec2> points;
+    std::vector<std::optional<std::string>> next;
+    const auto shown_camera = scene.camera;
+    const auto* shown_image = GCodeGLESSelfTestAccess::completed_image(*scene.gpu);
+    std::vector<uint8_t> shown_pixels(317 * 193 * 3);
+    for (int y = 0; y < 193; ++y)
+        std::memcpy(shown_pixels.data() + y * 317 * 3,
+                    shown_image->data + y * shown_image->header.stride, 317 * 3);
+    scene.camera.rotate(90.0f, 0.0f);
+    scene.camera.fit_to_bounds(scene.file->global_bounding_box);
+    size_t hits = 0, changed = 0;
+    for (int y = 4; y < 193; y += 8) {
+        for (int x = 4; x < 317; x += 8) {
+            const glm::vec2 point(x, y);
+            const auto before = picker.pick_object(point, *scene.file, shown_camera);
+            const auto after = picker.pick_object(point, *scene.file, scene.camera);
+            hits += before.has_value();
+            changed += before != after;
+            require(scene.gpu->pick_object(point, *scene.file, scene.camera) == before,
+                    "picking followed a camera whose image is not displayed yet");
+            points.push_back(point);
+            next.push_back(after);
+        }
+    }
+    require(hits > 0 && changed > 0, "picking fixture does not distinguish camera positions");
+    settle();
+    const auto* latest_image = GCodeGLESSelfTestAccess::completed_image(*scene.gpu);
+    bool image_changed = false;
+    for (int y = 0; y < 193; ++y)
+        image_changed |= std::memcmp(shown_pixels.data() + y * 317 * 3,
+                                    latest_image->data + y * latest_image->header.stride, 317 * 3) != 0;
+    require(image_changed, "camera changed but the displayed fixture image did not");
+    for (size_t i = 0; i < points.size(); ++i)
+        require(scene.gpu->pick_object(points[i], *scene.file, shown_camera) == next[i],
+                "picking did not advance with the latest completed image");
+
+    bool destroy_while_pending = false;
+    for (int attempt = 0; attempt < 8 && !destroy_while_pending; ++attempt) {
+        scene.camera.rotate(17.0f, 0.0f);
+        scene.camera.fit_to_bounds(scene.file->global_bounding_box);
+        draw();
+        destroy_while_pending = scene.gpu->is_uploading();
+    }
+    object.reset();
+    scene.file.reset();
+    const auto destroy_start = Clock::now();
+    scene.gpu.reset();
+    const double destroy_ms =
+        std::chrono::duration<double, std::milli>(Clock::now() - destroy_start).count();
+    require(reloaded_lifetime.expired(), "destroyed renderer retained its parsed model");
+    std::sort(scene.callback_times.begin(), scene.callback_times.end());
+    const size_t count = scene.callback_times.size();
+    require(count > 0, "async test never entered the draw callback");
+    report << "{\"mode\":\"async\",\"first_complete_ms\":" << first_ms
+           << ",\"latest_complete_ms\":" << latest_ms << ",\"reload_complete_ms\":" << reload_ms
+           << ",\"callback_median_ms\":" << scene.callback_times[count / 2]
+           << ",\"callback_p95_ms\":" << scene.callback_times[(count * 95 + 99) / 100 - 1]
+           << ",\"callback_max_ms\":" << scene.callback_times.back()
+           << ",\"callbacks\":" << count << ",\"clear_while_pending_observed\":"
+           << (clear_while_pending ? "true" : "false")
+           << ",\"checked_blue_frames\":" << checked_blue_frames
+           << ",\"picking_points\":" << points.size() << ",\"picking_changes\":" << changed
+           << ",\"destroy_while_pending_observed\":" << (destroy_while_pending ? "true" : "false")
+           << ",\"destroy_ms\":" << destroy_ms
+           << ",\"model_released\":true,\"passed\":true}\n";
+}
