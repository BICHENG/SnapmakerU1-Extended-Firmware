diff --git a/include/gcode_latest_frame.h b/include/gcode_latest_frame.h
new file mode 100644
index 0000000..63c8bbe
--- /dev/null
+++ b/include/gcode_latest_frame.h
@@ -0,0 +1,84 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+#include <condition_variable>
+#include <cstdint>
+#include <mutex>
+#include <optional>
+#include <utility>
+
+namespace helix::gcode::detail {
+
+// One renderer consumes the newest request. Completed frames remain usable while
+// a newer camera position is rendering; invalidating a model rejects its frames.
+template <typename Job, typename Frame> class LatestFrame {
+  public:
+    struct Request {
+        uint64_t epoch, sequence;
+        Job job;
+    };
+    void submit(Job job) {
+        std::lock_guard<std::mutex> lock(mutex_);
+        pending_ = Request{epoch_, ++submitted_, std::move(job)};
+        changed_.notify_one();
+    }
+    void invalidate() {
+        std::lock_guard<std::mutex> lock(mutex_);
+        ++epoch_;
+        pending_.reset();
+        complete_.reset();
+        consumed_ = submitted_;
+    }
+    bool take(Request& request) {
+        std::unique_lock<std::mutex> lock(mutex_);
+        changed_.wait(lock, [&] { return stopped_ || pending_.has_value(); });
+        if (stopped_)
+            return false;
+        auto newest = std::move(*pending_);
+        pending_.reset();
+        lock.unlock();
+        request = std::move(newest);
+        return true;
+    }
+    bool superseded(const Request& request) const {
+        std::lock_guard<std::mutex> lock(mutex_);
+        return stopped_ || request.epoch != epoch_ || pending_.has_value();
+    }
+    void publish(const Request& request, Frame frame) {
+        std::lock_guard<std::mutex> lock(mutex_);
+        if (!stopped_ && request.epoch == epoch_) {
+            complete_ = std::move(frame);
+            completed_ = request.sequence;
+        }
+    }
+    std::optional<Frame> consume() {
+        std::lock_guard<std::mutex> lock(mutex_);
+        if (!complete_)
+            return std::nullopt;
+        auto frame = std::move(complete_);
+        complete_.reset();
+        consumed_ = completed_;
+        return frame;
+    }
+    bool needs_frame() const {
+        std::lock_guard<std::mutex> lock(mutex_);
+        return consumed_ != submitted_;
+    }
+    void stop() {
+        std::lock_guard<std::mutex> lock(mutex_);
+        stopped_ = true;
+        pending_.reset();
+        complete_.reset();
+        changed_.notify_one();
+    }
+
+  private:
+    mutable std::mutex mutex_;
+    std::condition_variable changed_;
+    std::optional<Request> pending_;
+    std::optional<Frame> complete_;
+    uint64_t epoch_ = 0, submitted_ = 0, completed_ = 0, consumed_ = 0;
+    bool stopped_ = false;
+};
+
+} // namespace helix::gcode::detail
