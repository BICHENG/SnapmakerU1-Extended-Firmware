+namespace detail {
+enum class LayerPass { Solid, Ghost };
+
+// Keep the original vertex order. Adjacent selected runs can share one draw;
+// gaps and unselected objects stay opaque in the selection-tag channel.
+template <typename Draw>
+void for_each_layer_draw_range(size_t vertex_count, ObjectRunSpan runs,
+                               const std::vector<bool>& highlighted, LayerPass pass, Draw&& draw) {
+    if (!vertex_count)
+        return;
+    if (pass == LayerPass::Ghost || highlighted.empty() || runs.empty()) {
+        draw(0, vertex_count, false);
+        return;
+    }
+    size_t cursor = 0, selected_start = 0, selected_end = 0;
+    auto flush_selected = [&] {
+        if (selected_start == selected_end)
+            return;
+        if (cursor < selected_start)
+            draw(cursor, selected_start - cursor, false);
+        draw(selected_start, selected_end - selected_start, true);
+        cursor = selected_end;
+    };
+    for (const auto& run : runs) {
+        if (run.object_index < 0 || static_cast<size_t>(run.object_index) >= highlighted.size() ||
+            !highlighted[static_cast<size_t>(run.object_index)] || !run.vertex_count)
+            continue;
+        const size_t first = run.vertex_offset;
+        const size_t end = first + run.vertex_count;
+        // Incremental upload can leave a VBO shorter than its geometry's runs.
+        if (first < selected_end || end > vertex_count)
+            continue;
+        if (first == selected_end && selected_start != selected_end) {
+            selected_end = end;
+        } else {
+            flush_selected();
+            selected_start = first;
+            selected_end = end;
+        }
+    }
+    flush_selected();
+    if (cursor < vertex_count)
+        draw(cursor, vertex_count - cursor, false);
+}
