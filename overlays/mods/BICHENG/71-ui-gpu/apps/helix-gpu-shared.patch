+    scene.gpu.set_ghost_opacity(64);
+    const auto ghost64 = capture("ghost_64");
+    require(alpha(ghost64) == lower_alpha && ghost64 != lower, "half-transparent ghost changed tags or was not drawn");
+    scene.gpu.set_ghost_opacity(255);
+    const auto ghost255 = capture("ghost_255");
+    require(alpha(ghost255) == lower_alpha && ghost255 != ghost64,
+            "opaque ghost changed tags or ignored opacity");
+    scene.gpu.set_print_progress_layer(-1);
+    const auto all_alpha = alpha(capture("solid_all"));
+    require(std::count(all_alpha.begin(), all_alpha.end(), kSelectedAlpha) >
+                std::count(lower_alpha.begin(), lower_alpha.end(), kSelectedAlpha),
+            "upper fixture layer must contain visible selected pixels");
+    scene.gpu.set_highlighted_objects({});
+    const auto none = alpha(capture("none_selected"));
+    require(std::all_of(none.begin(), none.end(), [](uint8_t value) { return value == 255; }),
+            "clearing selection left stale tags");
+    scene.gpu.set_highlighted_object("other");
+    const auto other = alpha(capture("other_selected"));
+    require(std::count(other.begin(), other.end(), kSelectedAlpha) > 0, "second object was not tagged");
+    for (size_t i = 0; i < other.size(); ++i)
+        require(other[i] != kSelectedAlpha || all_alpha[i] != kSelectedAlpha,
+                "disjoint objects share selection tags");
+    scene.gpu.set_highlighted_object("selected");
+    scene.gpu.set_layer_range(0, 0);
+    require(alpha(capture("solid_lower_again")) == lower_alpha, "state changes left stale alpha");
+    report << "],\"passed\":true}\n";
+    require(raw.good() && report.good(), "cannot write alpha evidence");
+    lv_obj_delete(object);
+}
+
+} // namespace
+
+int main(int argc, char** argv) {
+    if (argc < 2 || argc > 3) {
+        std::fprintf(stderr, "Usage: helix-gpu-self-test OUTPUT_DIRECTORY [GCODE_FILE]\n");
+        return 2;
+    }
+    try {
+        const std::filesystem::path output = std::filesystem::absolute(argv[1]);
+        std::filesystem::create_directories(output / "config");
+        setenv("HELIX_CONFIG_DIR", (output / "config").c_str(), 1);
+        helix::internal::set_main_thread_id();
+        spdlog::set_level(spdlog::level::debug);
+        auto file = parse(argc == 3 ? argv[2] : nullptr);
+        lv_init();
+        lv_tick_set_cb([]() -> uint32_t {
+            return static_cast<uint32_t>(std::chrono::duration_cast<std::chrono::milliseconds>(
+                Clock::now().time_since_epoch()).count());
+        });
+        lv_xml_init();
+        lv_display_t* display = lv_display_create(480, 320);
+        require(display != nullptr, "memory display allocation failed");
+        std::vector<uint8_t> framebuffer(480 * 320 * 4);
+        lv_display_set_color_format(display, LV_COLOR_FORMAT_ARGB8888);
+        lv_display_set_buffers(display, framebuffer.data(), nullptr, framebuffer.size(),
+                               LV_DISPLAY_RENDER_MODE_FULL);
+        lv_display_set_flush_cb(display, [](lv_display_t* d, const lv_area_t*, uint8_t*) {
+            lv_display_flush_ready(d);
+        });
+        std::ofstream report(output / "result.json");
+        require(report.good(), "cannot open report");
+        const char* enabled = std::getenv("UI_GPU_ENABLED");
+        const bool off = enabled && std::strcmp(enabled, "0") == 0;
+        {
+            Scene scene(file, off);
+            lv_obj_t* object = lv_obj_create(lv_screen_active());
+            lv_obj_remove_style_all(object);
+            lv_obj_remove_flag(object, LV_OBJ_FLAG_SCROLLABLE);
+            lv_obj_add_event_cb(object, Scene::draw, LV_EVENT_DRAW_MAIN, &scene);
+            report << "{\"geometry_vertices\":" << scene.geometry_vertices
+                   << ",\"geometry_triangles\":" << scene.geometry_triangles
+                   << ",\"gpu_upload_vertices\":" << scene.gpu_upload_vertices
+                   << ",\"cases\":[";
+            run_case(scene, object, 480, 320, 45, 35, output / "full", report);
+            report << ',';
+            run_case(scene, object, 317, 193, 0, 85, output / "compact", report);
+            report << "]}\n";
+            lv_obj_delete(object);
+        }
+        if (!off)
+            check_progress_alpha(output);
+        lv_deinit();
+        lv_xml_deinit();
+        require(report.good(), "cannot write report");
+        return 0;
+    } catch (const std::exception& error) {
+        std::fprintf(stderr, "GPU self-test failed: %s\n", error.what());
+        return 1;
+    }
+}
