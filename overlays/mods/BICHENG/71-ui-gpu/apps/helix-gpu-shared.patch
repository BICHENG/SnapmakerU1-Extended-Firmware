new file mode 100644
index 0000000..1d906ae
--- /dev/null
+++ b/tests/standalone/gcode_latest_frame.cpp
@@ -0,0 +1,81 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "gcode_latest_frame.h"
+
+#include <cassert>
+#include <future>
+#include <memory>
+#include <thread>
+
+using helix::gcode::detail::LatestFrame;
+
+int main() {
+    using Queue = LatestFrame<std::shared_ptr<int>, int>;
+    Queue frames;
+    Queue::Request current{};
+    auto first = std::make_shared<int>(1);
+    std::weak_ptr<int> old = first;
+    frames.submit(std::move(first));
+    frames.submit(std::make_shared<int>(2));
+    assert(old.expired()); // An unstarted job does not keep an obsolete model alive.
+    assert(frames.take(current) && *current.job == 2);
+
+    frames.submit(std::make_shared<int>(3));
+    assert(frames.superseded(current));
+    frames.publish(current, 2);
+    assert(frames.consume() == 2); // New camera work may display the last complete frame.
+    assert(frames.needs_frame());
+    assert(frames.take(current) && *current.job == 3);
+    frames.publish(current, 3);
+    assert(frames.consume() == 3 && !frames.needs_frame());
+
+    frames.submit(std::make_shared<int>(4));
+    assert(frames.take(current));
+    frames.invalidate(); // A file change must reject an in-flight old model.
+    frames.publish(current, 4);
+    assert(!frames.consume() && !frames.needs_frame());
+    assert(frames.superseded(current));
+
+    std::promise<void> entered;
+    std::thread idle([&] {
+        entered.set_value();
+        assert(!frames.take(current));
+    });
+    entered.get_future().wait();
+    frames.stop();
+    idle.join(); // Destruction wakes an idle worker without a final rendering job.
+
+    // The caller may release a model while a job is running. Its worker-owned
+    // shared pointer must keep it alive until that job has finished.
+    Queue ownership;
+    auto model = std::make_shared<int>(5);
+    std::weak_ptr<int> life = model;
+    ownership.submit(model);
+    assert(ownership.take(current));
+    model.reset();
+    ownership.invalidate();
+    assert(!life.expired());
+    current.job.reset();
+    assert(life.expired());
+    ownership.stop();
+
+    LatestFrame<int, int> burst;
+    std::promise<void> started, release;
+    auto continue_rendering = release.get_future();
+    std::thread renderer([&] {
+        LatestFrame<int, int>::Request request{};
+        assert(burst.take(request) && request.job == 1);
+        started.set_value();
+        continue_rendering.wait();
+        burst.publish(request, request.job);
+        assert(burst.take(request) && request.job == 1000);
+        burst.publish(request, request.job);
+    });
+    burst.submit(1);
+    started.get_future().wait();
+    for (int n = 2; n <= 1000; ++n)
+        burst.submit(n);
+    release.set_value();
+    renderer.join();
+    assert(burst.consume() == 1000 && !burst.needs_frame());
+    burst.stop();
+}
