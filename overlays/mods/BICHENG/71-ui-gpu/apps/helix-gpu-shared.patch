+GCodeGLESRenderer::GCodeGLESRenderer(const selection::Palette& palette) : sel_palette_(palette) {}
+
+void GCodeGLESRenderer::enable_async() {
+    if (async_ || gl_initialized_ || geometry_)
+        return;
+    const char* enabled = std::getenv("UI_GPU_ENABLED");
+    if (enabled && std::strcmp(enabled, "0") == 0) {
+        gl_init_failed_ = true;
+        return;
+    }
+    try {
+        async_ = std::make_unique<AsyncState>(sel_palette_);
+    } catch (const std::exception& error) {
+        gl_init_failed_ = true;
+        spdlog::error("[GCode GLES] Cannot start async renderer: {}", error.what());
+    }
+}
+
+void GCodeGLESRenderer::render_async(lv_layer_t* layer,
+                                      std::shared_ptr<const ParsedGCodeFile> gcode,
+                                      const GCodeCamera& camera, const lv_area_t* coords) {
+    if (!async_ || render_failed() || !async_->model || !gcode)
+        return;
+    const auto matrix = camera.get_view_projection_matrix();
+    const int width = lv_area_get_width(coords), height = lv_area_get_height(coords);
+    if (width <= 0 || height <= 0)
+        return;
+    set_viewport_size(width, height);
+    if (frame_dirty_ || !async_->camera_valid || matrix != async_->last_camera) {
+        async_->frames.submit({async_->model, std::move(gcode), camera, async_->snapshot(*this)});
+        async_->last_camera = matrix;
+        async_->camera_valid = true;
+        frame_dirty_ = false;
+    }
+    if (auto completed = async_->frames.consume()) {
+        if (completed->view.width == width && completed->view.height == height) {
+            if (!draw_buf_ || draw_buf_width_ != width || draw_buf_height_ != height) {
+                helix::safe_draw_buf_destroy(draw_buf_, "gles_async_draw_buf");
+                draw_buf_ = lv_draw_buf_create(width, height, LV_COLOR_FORMAT_RGB888, 0);
+                draw_buf_width_ = width;
+                draw_buf_height_ = height;
+            } else {
+                lv_draw_wait_for_finish();
+            }
+            if (!draw_buf_) {
+                gl_render_failed_ = true;
+                return;
+            }
+            for (int y = 0; y < height; ++y)
+                std::memcpy(draw_buf_->data + static_cast<size_t>(y) * draw_buf_->header.stride,
+                            completed->pixels.data() + static_cast<size_t>(y) * width * 3,
+                            static_cast<size_t>(width) * 3);
+            triangles_rendered_ = completed->triangles;
+            async_->memory = std::move(completed->memory);
+            async_->shown = completed->view;
+        }
+    }
+    draw_cached_to_lvgl(layer, coords);
+}
+#endif
+
+bool GCodeGLESRenderer::is_uploading() const {
+#ifdef HELIX_PLATFORM_SNAPMAKER_U1
+    if (async_)
+        return async_->model && (!draw_buf_ || async_->frames.needs_frame());
+#endif
+    return geometry_ && !geometry_uploaded_;
+}
+
+bool GCodeGLESRenderer::has_geometry() const {
+#ifdef HELIX_PLATFORM_SNAPMAKER_U1
+    if (async_)
+        return async_->model != nullptr;
+#endif
+    return geometry_ != nullptr;
+}
+
+bool GCodeGLESRenderer::render_failed() const {
+#ifdef HELIX_PLATFORM_SNAPMAKER_U1
+    if (async_ && async_->failed.load())
+        return true;
+#endif
+    return gl_init_failed_ || gl_render_failed_;
+}
