+void nvgImageTriangles(NVGcontext * ctx, int image, NVGcolor color, NVGvertex * vertices, int count)
+{
+    NVGstate * state = nvg__getState(ctx);
+    NVGpaint paint = nvgImagePattern(ctx, 0, 0, 1, 1, 0, image, 1);
+    color.ch.a *= state->alpha;
+    paint.innerColor = paint.outerColor = color;
+    for(int i = 0; i < count; ++i) {
+        nvgTransformPoint(&vertices[i].x, &vertices[i].y, state->xform, vertices[i].x, vertices[i].y);
+    }
+    ctx->params.renderTriangles(ctx->params.userPtr, &paint, state->compositeOperation,
+        &state->scissor, vertices, count, ctx->fringeWidth);
+    ++ctx->drawCallCount;
+}
+
