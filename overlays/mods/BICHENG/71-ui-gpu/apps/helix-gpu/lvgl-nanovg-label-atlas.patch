+enum { LETTER_ATLAS_SIZE = 1024, LETTER_BATCH_VERTICES = 1536 };
+typedef struct {
+    int image, x, y, row_height;
+    uint8_t * pixels;
+    NVGvertex vertices[LETTER_BATCH_VERTICES];
+    int count, batch_image;
+    NVGcolor color;
+} letter_atlas_t;
+
+static void letter_batch_flush(lv_draw_nanovg_unit_t * u)
+{
+    letter_atlas_t * a = u->letter_atlas;
+    if(!a->count) return;
+    nvgImageTriangles(u->vg, a->batch_image, a->color, a->vertices, a->count);
+    a->count = 0;
+}
+
+static void letter_submit_pending(lv_draw_nanovg_unit_t * u)
+{
+    letter_batch_flush(u);
+    nvgEndFrame(u->vg);
+    lv_pending_remove_all(u->image_pending);
+    lv_pending_remove_all(u->letter_pending);
+    /* Preserve the current transform and scissor while continuing this label. */
+}
+
+static bool letter_atlas_fits(uint32_t w, uint32_t h)
+{
+    return w > 0 && h > 0 && w + 2 <= LETTER_ATLAS_SIZE && h + 2 <= LETTER_ATLAS_SIZE;
+}
+
+static void letter_atlas_reserve(lv_draw_nanovg_unit_t * u, uint32_t w, uint32_t h)
+{
+    letter_atlas_t * a = u->letter_atlas;
+    if(!letter_atlas_fits(w, h)) return;
+    if(a->x + w + 1 > LETTER_ATLAS_SIZE) {
+        a->x = 1; a->y += a->row_height + 1; a->row_height = 0;
+    }
+    if(a->y + h + 1 <= LETTER_ATLAS_SIZE) return;
+    /* No cache lock is held here. Flush and release pending references before eviction. */
+    letter_submit_pending(u);
+    lv_cache_drop_all(u->letter_cache, NULL);
+    lv_memzero(a->pixels, LETTER_ATLAS_SIZE * LETTER_ATLAS_SIZE);
+    nvgUpdateImage(u->vg, a->image, a->pixels);
+    a->x = a->y = 1; a->row_height = 0;
+}
+
 
