#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# SPDX-PackageHomePage: https://github.com/BICHENG/SnapmakerU1-Extended-Firmware
# SPDX-FileCopyrightText: Copyright (c) 2026 BICHENG
#
# auxmic: the phone microphone as a sound card.
#
# Two processes make up the device side:
#
#   auxmic-pacer      holds hw:Loopback,0 and feeds it the audio that
#                     arrives on the link.  It runs as root, because the
#                     sound devices belong to the audio group.
#   auxmic-transport  serves the phone page over https and hands the audio
#                     to the pacer over a local socket.  It runs as lava,
#                     because it only writes into the printer's own
#                     configuration directory.
#
# The loopback module belongs to the firmware, not to this mod, but nothing
# loads it until this script says so.

umask 022

NAME="auxmic"
RUN_DIR="/run/auxmic"
DATA_DIR="/userdata/auxmic"
CONFIG_DIR="/home/lava/printer_data/config/extended/auxmic"
PACER_PIDFILE="$RUN_DIR/pacer.pid"
TRANSPORT_PIDFILE="$RUN_DIR/transport.pid"
PACER_LOG="$DATA_DIR/pacer.log"
TRANSPORT_LOG="$DATA_DIR/transport.log"
ALSA_DEVICE="hw:Loopback,0"
LINK_PORT="9444"
HTTP_PORT="9443"
MODULE="/lib/modules/snd-aloop.ko"
CERT_SCRIPT="/usr/local/bin/auxmic-cert.sh"
PYTHON="/usr/bin/python3"

. /usr/local/share/auxmic/common.sh

pid_alive() {
    [ -f "$1" ] || return 1
    pid=$(cat "$1" 2>/dev/null) || return 1
    case "$pid" in
        ''|*[!0-9]*) return 1 ;;
    esac
    kill -0 "$pid" 2>/dev/null
}

card_ready() {
    grep -q Loopback /proc/asound/cards 2>/dev/null
}

load_loopback() {
    if card_ready; then
        return 0
    fi
    if [ ! -f "$MODULE" ]; then
        echo "$NAME: $MODULE is missing from the firmware" >&2
        return 1
    fi
    if ! insmod "$MODULE"; then
        echo "$NAME: the loopback module did not load" >&2
        return 1
    fi
    attempt=0
    while [ "$attempt" -lt 25 ]; do
        card_ready && return 0
        sleep 0.2
        attempt=$((attempt + 1))
    done
    echo "$NAME: the loopback card did not show up" >&2
    return 1
}

# The storage is a partition that may still be mounting when this runs.
prepare_storage() {
    attempt=0
    while [ "$attempt" -lt 30 ]; do
        if grep -q ' /userdata ' /proc/mounts 2>/dev/null; then
            mkdir -p "$DATA_DIR" "$CONFIG_DIR" "$RUN_DIR" || return 1
            chown -R lava:lava "$DATA_DIR" "$CONFIG_DIR" 2>/dev/null || true
            return 0
        fi
        sleep 1
        attempt=$((attempt + 1))
    done
    echo "$NAME: /userdata did not show up" >&2
    return 1
}

start_pacer() {
    if pid_alive "$PACER_PIDFILE"; then
        echo "$NAME: the device half is already running"
        return 0
    fi
    : > "$PACER_LOG"
    if [ -r /usr/local/sbin/limits-helper.sh ]; then
        . /usr/local/sbin/limits-helper.sh
        limits_enter auxmic-pacer 32M
    fi
    start-stop-daemon -S -b -m -q -p "$PACER_PIDFILE" -x /bin/sh -- -c \
        "exec $PYTHON /usr/local/bin/auxmic-pacer.py --sink alsa --device $ALSA_DEVICE --host 127.0.0.1 --port $LINK_PORT --status $RUN_DIR/pacer.json >> $PACER_LOG 2>&1"
    attempt=0
    while [ "$attempt" -lt 15 ]; do
        if pid_alive "$PACER_PIDFILE" && [ -s "$RUN_DIR/pacer.json" ]; then
            echo "$NAME: the device half is running"
            return 0
        fi
        sleep 1
        attempt=$((attempt + 1))
    done
    echo "$NAME: the device half did not come up; see $PACER_LOG" >&2
    return 1
}

start_transport() {
    if pid_alive "$TRANSPORT_PIDFILE"; then
        echo "$NAME: the transport is already running"
        return 0
    fi
    : > "$TRANSPORT_LOG"
    chown lava:lava "$TRANSPORT_LOG" 2>/dev/null || true
    "$CERT_SCRIPT" "$CONFIG_DIR" || return 1
    start-stop-daemon -S -b -m -q -p "$TRANSPORT_PIDFILE" -c lava -x /bin/sh -- -c \
        "exec $PYTHON /usr/local/bin/auxmic-transport.py --host 0.0.0.0 --port $HTTP_PORT --config-dir $CONFIG_DIR --link-host 127.0.0.1 --link-port $LINK_PORT >> $TRANSPORT_LOG 2>&1"
    attempt=0
    while [ "$attempt" -lt 15 ]; do
        if pid_alive "$TRANSPORT_PIDFILE" && [ -s "$CONFIG_DIR/pairing.token" ]; then
            echo "$NAME: the transport is running"
            return 0
        fi
        sleep 1
        attempt=$((attempt + 1))
    done
    echo "$NAME: the transport did not come up; see $TRANSPORT_LOG" >&2
    return 1
}

stop_process() {
    pidfile="$1"
    label="$2"
    printf "Stopping %s: " "$label"
    if pid_alive "$pidfile"; then
        start-stop-daemon -K -p "$pidfile" -s TERM >/dev/null 2>&1
        attempt=0
        while [ "$attempt" -lt 10 ] && pid_alive "$pidfile"; do
            sleep 1
            attempt=$((attempt + 1))
        done
        if pid_alive "$pidfile"; then
            start-stop-daemon -K -p "$pidfile" -s KILL >/dev/null 2>&1
        fi
        rm -f "$pidfile"
        echo "OK"
    else
        rm -f "$pidfile"
        echo "not running"
    fi
}

start() {
    load_loopback || return 1
    prepare_storage || return 1
    start_pacer || return 1
    start_transport || return 1
    address=$(auxmic_address)
    echo "$NAME: the phone page is at https://$address:$HTTP_PORT/"
    if [ -r "$CONFIG_DIR/pairing.token" ]; then
        echo "$NAME: the pairing code is $(cat "$CONFIG_DIR/pairing.token")"
    fi
    return 0
}

stop() {
    stop_process "$TRANSPORT_PIDFILE" "the transport"
    stop_process "$PACER_PIDFILE" "the device half"
}

status() {
    if pid_alive "$PACER_PIDFILE" && pid_alive "$TRANSPORT_PIDFILE"; then
        echo "$NAME is running (device half pid $(cat "$PACER_PIDFILE"), transport pid $(cat "$TRANSPORT_PIDFILE"))"
        address=$(auxmic_address)
        echo "phone page: https://$address:$HTTP_PORT/"
        if [ -r "$CONFIG_DIR/pairing.token" ]; then
            echo "pairing code: $(cat "$CONFIG_DIR/pairing.token")"
        fi
        return 0
    fi
    echo "$NAME is not running"
    return 1
}

case "$1" in
    start) start ;;
    stop) stop ;;
    restart|reload) stop; sleep 1; start ;;
    status) status ;;
    *) echo "Usage: $0 {start|stop|restart|status}" >&2; exit 1 ;;
esac
